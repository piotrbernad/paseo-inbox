#!/usr/bin/env bash
# Runs the paseo-inbox CLI with the Node bundled in Paseo.app, so nothing needs installing.
set -euo pipefail

source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  case "$source" in /*) ;; *) source="$dir/$source" ;; esac
done
root="$(cd -P "$(dirname "$source")/.." && pwd)"

# The hook runs after every tool call. When the agent's fast-path file (written by the hook itself,
# see server/hook.ts) says the store has not moved and no sync is due, answer without starting Node.
# Only the start of stdin is read here: tool output can be large, and bash reads byte by byte.
if [ "${1:-}" = hook ] && [ -n "${PASEO_AGENT_ID:-}" ]; then
  IFS= read -r -d '' -n 2048 start || true
  fast="${TMPDIR:-/tmp}/paseo-inbox-$UID/$PASEO_AGENT_ID"
  if [[ $start =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"PostToolUse\" ]] &&
    { read -r config && read -r ref && read -r sha && read -r due; } 2>/dev/null <"$fast" &&
    [ "$config" = "${PASEO_INBOX_CONFIG:-$HOME/.paseo/inbox.json}" ] &&
    read -r current 2>/dev/null <"$ref" && [ "$current" = "$sha" ] &&
    [ "$(date +%s)" -lt "$due" ]; then
    exec cat >/dev/null
  fi
fi

resources="${PASEO_RESOURCES:-}"
if [ -z "$resources" ]; then
  for candidate in /Applications/Paseo.app/Contents/Resources "$HOME/Applications/Paseo.app/Contents/Resources"; do
    if [ -e "$candidate/app.asar" ]; then resources="$candidate"; break; fi
  done
fi
if [ -z "$resources" ] || [ ! -e "$resources/app.asar" ]; then
  echo "paseo-inbox: Paseo.app not found; set PASEO_RESOURCES to its Contents/Resources directory" >&2
  exit 1
fi
helper="$resources/../Frameworks/Paseo Helper.app/Contents/MacOS/Paseo Helper"

run() {
  exec env ELECTRON_RUN_AS_NODE=1 PASEO_NODE_ENV=production PASEO_RESOURCES="$resources" "$helper" \
    --disable-warning=DEP0040 --disable-warning=ExperimentalWarning \
    "$resources/app.asar.unpacked/dist/daemon/node-entrypoint-runner.js" \
    node-script "$root/server/cli/main.ts" "$@"
}
if [ "${start+set}" = set ]; then
  { printf '%s' "$start"; exec cat; } | run "$@"
else
  run "$@"
fi
